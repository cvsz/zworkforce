{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.zeaz.dev/zarvis/proactive-signal.v1.schema.json","title":"ZARVIS Proactive Signal v1","type":"object","additionalProperties":false,
