{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zeaz.dev/zarvis/memory-snapshot.v1.schema.json",
  "title": "ZARVIS Memory Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "revision", "content", "classification", "reason", "confidence", "retention_days", "expires_at", "provenance", "owner_user_id", "tenant_id", "created_at", "updated_at", "confirmed_at", "proposal_id"],
  "properties": {
    "schema_version": { "const": "zarvis.memory.snapshot.v1" },
    "memory_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "classification": { "enum": ["working", "episodic", "semantic", "procedural"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "expires_at": { "type": "string", "format": "date-time" },
    "provenance": { "$ref": "zarvis.memory.proposal.v1.schema.json#/$defs/provenance" },
    "owner_user_id": { "const": "github:4076926" },
    "tenant_id": { "const": "owner-4076926" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "proposal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "replayed": { "type": "boolean" },
    "retrieval_score": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
