{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zeaz.dev/zarvis/perception-session.v1.schema.json",
  "title": "ZARVIS Perception Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "purpose", "modalities", "retention_minutes", "retention_expires_at", "status", "created_at", "owner_user_id", "tenant_id", "results"],
  "properties": {
    "schema_version": { "const": "zarvis.perception.session.v1" },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["image", "document", "screen", "camera"] }
    },
    "retention_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "retention_expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pending_consent", "active", "stopped"] },
    "consent_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "consent_nonce": { "type": "string", "minLength": 1, "maxLength": 128 },
    "consent_expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "activated_at": { "type": "string", "format": "date-time" },
    "active_expires_at": { "type": "string", "format": "date-time" },
    "stopped_at": { "type": "string", "format": "date-time" },
    "owner_user_id": { "const": "github:4076926" },
    "tenant_id": { "const": "owner-4076926" },
    "results": {
      "type": "array",
      "items": { "$ref": "zarvis.perception.result.v1.schema.json" }
    }
  }
}
