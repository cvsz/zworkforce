{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.zeaz.dev/zarvis/proactive-notification.v1.schema.json","title":"ZARVIS Proactive Notification v1","type":"object","additionalProperties":false,
