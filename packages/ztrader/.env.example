# ztrader Platform Configuration Example
# Copy this file to .env and configure appropriate values before running.
# Never commit real .env files or production secrets.

# System Environment
ENVIRONMENT=production
HOST=127.0.0.1
BACKEND_PORT=8016
FRONTEND_PORT=3016
PORT=8016

# Public route mapping
ZTRADER_PUBLIC_URL=https://ztrader.zeaz.dev
NEXT_PUBLIC_BACKEND_URL=https://api-ztrader.zeaz.dev
NEXT_PUBLIC_API_BASE_URL=https://api-ztrader.zeaz.dev/api/v1

# Database & Cache URLs
DATABASE_URL=postgresql+asyncpg://ztrader:example-db-password@localhost:5432/ztrader_db
REDIS_URL=redis://localhost:6379/0

# Security placeholders only. Generate real values locally and keep them outside git.
ENCRYPTION_KEY=example-32-byte-secret
JWT_SECRET=example-jwt-secret
ADMIN_API_TOKEN=example-admin-token
TRADINGVIEW_WEBHOOK_SECRET=example-webhook-secret

# Trading Defaults
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH=true

# Risk Limits
RISK_MAX_ORDER_NOTIONAL=100.0
RISK_ALLOWED_SYMBOLS='["BTC/USDT","ETH/USDT"]'

# Exchange API Credentials (Binance & Binance TH)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TH_API_KEY=
BINANCE_TH_SECRET_KEY=

# Google OAuth 2.0 Credentials placeholders
GOOGLE_CLIENT_ID=example-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-google-client-secret

# TradingAgents LLM Integration
# Set your preferred LLM provider API key
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.5
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=false
TRADINGAGENTS_TEMPERATURE=

# LLM Provider API Keys (set the one matching TRADINGAGENTS_LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Data Provider API Keys (optional)
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Ollama Local LLM (optional)
OLLAMA_BASE_URL=http://localhost:11434/v1
