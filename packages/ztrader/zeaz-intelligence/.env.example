ZTRADER_INTEL_PORT=8218
ZTRADER_INTEL_DB=./data/ztrader_intel.db
HTTP_TIMEOUT_SECONDS=12

DEXSCREENER_BASE_URL=https://api.dexscreener.com

GOPLUS_BASE_URL=https://api.gopluslabs.io
GOPLUS_API_TOKEN=

# Canonical ZeaZ AI gateway. Service-to-service calls require an API key.
ZAIMAN_BASE_URL=http://zaiman:20128/v1
ZAIMAN_API_KEY=
ZAIMAN_MODEL=

# Canonical deterministic execution/risk boundary. zTrader only submits advisory intents.
ZKSATO_BASE_URL=http://zksato:9569
ZKSATO_API_KEY=

# Canonical read-only on-chain evidence boundary.
ZWALLET_BASE_URL=http://zwallet-api:8000
ZWALLET_SERVICE_TOKEN=

# Temporary direct-provider fallback while clients migrate to Zaiman.
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.6

ZTRADER_LIVE_EXECUTION=false
