# ZWORKFORCE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ZWORKFORCE_EMBEDDING_API_KEY=
# ZWORKFORCE_EMBEDDING_MODEL=text-embedding-3-small
# ZWORKFORCE_EMBEDDING_DIMENSIONS=0
# ZWORKFORCE_EMBEDDING_TIMEOUT_SECONDS=30
ZWORKFORCE_OUTBOX_ALLOWLIST=
ZWORKFORCE_EMBEDDING_API_KEY_REF=
ZWORKFORCE_QDRANT_API_KEY_REF=

# Z.A.R.V.I.S. Local Action Gateway & Proactive Scheduler (Docker Compose)
# Minimum 32 bytes required. For local development, generate and export random tokens before running Docker Compose:
# export ZARVIS_LOCAL_OWNER_TOKEN="$(openssl rand -hex 32)"
# export ZARVIS_ACTION_WORKER_TOKEN="$(openssl rand -hex 32)"
# export ZARVIS_PROACTIVE_WORKER_TOKEN="$(openssl rand -hex 32)"
ZARVIS_LOCAL_OWNER_TOKEN=
ZARVIS_ACTION_WORKER_TOKEN=
ZARVIS_PROACTIVE_WORKER_TOKEN=