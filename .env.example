# zWorkforce v3.0.2
ZWORKFORCE_ENV=development
ZWORKFORCE_HOST=0.0.0.0
ZWORKFORCE_PORT=9569
# Docker host port for the production Compose API; the container stays on 9569.
ZWORKFORCE_HOST_PORT=9570
ZWORKFORCE_DATA_DIR=./data
ZWORKFORCE_WORKSPACE_ROOT=.
ZWORKFORCE_ARTIFACT_DIR=./data/artifacts
ZWORKFORCE_DEFAULT_TENANT=default

# SQLite remains the zero-dependency default. Set this for PostgreSQL distributed workers.
# ZWORKFORCE_DATABASE_URL=postgresql://zworkforce:change-me@127.0.0.1:5432/zworkforce
# Or resolve the DSN from env://, file://, aws-sm://, or vault://.
ZWORKFORCE_DATABASE_URL_REF=

# secret:role[:tenant[:name[:scope1|scope2]]]
# Production secrets must be long random values. Voice users need the voice:use scope
# unless their key has the wildcard scope.
ZWORKFORCE_API_KEYS=dev-admin:superadmin:default:local-admin:*
ZWORKFORCE_API_RATE_LIMIT_PER_MINUTE=240
ZWORKFORCE_CORS_ORIGINS=

# Z.A.R.V.I.S. dashboard realtime voice. Disabled by default.
# The service token is server-side only and must never be placed in browser/static config.
ZWORKFORCE_ZARVIS_VOICE_ENABLED=false
ZWORKFORCE_ZARVIS_VOICE_GATEWAY_URL=http://127.0.0.1:8450
ZWORKFORCE_ZARVIS_VOICE_SERVICE_TOKEN=
ZWORKFORCE_ZARVIS_VOICE_MODEL=default
ZWORKFORCE_ZARVIS_VOICE_TIMEOUT_SECONDS=5
# Required in production when voice is enabled. List exact browser-visible WS origins.
# Example: wss://voice.example.com or ws://127.0.0.1:8450 for local development.
ZWORKFORCE_ZARVIS_VOICE_WS_ALLOWLIST=ws://127.0.0.1:8450

# Worker / lease settings
ZWORKFORCE_EMBEDDED_WORKERS=1
ZWORKFORCE_WORKER_POLL_MS=250
ZWORKFORCE_LEASE_SECONDS=60
ZWORKFORCE_LEASE_HEARTBEAT_SECONDS=15
ZWORKFORCE_MAX_ATTEMPTS=3
ZWORKFORCE_RETRY_BASE_SECONDS=2
ZWORKFORCE_MAX_DELEGATION_DEPTH=8

# zktcoder free-model coding CLI. All optional; defaults hit the local gateway.
# ZKTCODER_BASE_URL=http://127.0.0.1:9569/v1
# ZKTCODER_API_KEY=
# ZKTCODER_MODEL=deepseek/deepseek-v4-flash
# ZKTCODER_TIMEOUT_SECONDS=90

# Provider pool. `api_key_ref` is supported in each JSON provider object.
ZWORKFORCE_PROVIDER=mock
ZWORKFORCE_PROVIDER_BASE_URL=https://api.openai.com/v1
ZWORKFORCE_PROVIDER_API_KEY=
ZWORKFORCE_PROVIDER_API_KEY_REF=
ZWORKFORCE_MODEL_SOL=gpt-5.6
ZWORKFORCE_MODEL_TERRA=gpt-5.6-terra
ZWORKFORCE_MODEL_LUNA=gpt-5.6-luna
# ZWORKFORCE_PROVIDERS_JSON=[{"name":"primary","kind":"openai-compatible","base_url":"https://api.openai.com/v1","api_key_ref":"env://OPENAI_API_KEY","priority":10,"models":{"sol":"gpt-5.6","terra":"gpt-5.6-terra","luna":"gpt-5.6-luna"}}]
ZWORKFORCE_PROVIDER_CIRCUIT_FAILURES=3
ZWORKFORCE_PROVIDER_CIRCUIT_SECONDS=30

# Tool policy
ZWORKFORCE_HTTP_ALLOWLIST=
ZWORKFORCE_HTTP_ALLOW_PRIVATE=false
ZWORKFORCE_HTTP_MUTATING_ENABLED=false
ZWORKFORCE_HTTP_MAX_REDIRECTS=2
ZWORKFORCE_SHELL_ENABLED=false
ZWORKFORCE_SHELL_ALLOWLIST=git,python,python3,node,npm
ZWORKFORCE_SHELL_ENV_ALLOWLIST=PATH,HOME,LANG,LC_ALL,TZ
ZWORKFORCE_TOOL_TIMEOUT_SECONDS=30
ZWORKFORCE_TOOL_MAX_OUTPUT_BYTES=262144
ZWORKFORCE_WORKSPACE_WRITE_MAX_BYTES=1048576
ZWORKFORCE_MAX_REQUEST_BYTES=1048576

# AI FinOps credit rates. Override with your current contract/rate card.
ZWORKFORCE_GLOBAL_DAILY_BUDGET_CREDITS=0
ZWORKFORCE_SOL_INPUT_CREDITS=125
ZWORKFORCE_SOL_CACHED_CREDITS=12.5
ZWORKFORCE_SOL_OUTPUT_CREDITS=750
ZWORKFORCE_TERRA_INPUT_CREDITS=50
ZWORKFORCE_TERRA_CACHED_CREDITS=5
ZWORKFORCE_TERRA_OUTPUT_CREDITS=300
ZWORKFORCE_LUNA_INPUT_CREDITS=5
ZWORKFORCE_LUNA_CACHED_CREDITS=0.5
ZWORKFORCE_LUNA_OUTPUT_CREDITS=30

# Signed skill registry
ZWORKFORCE_SKILL_SIGNING_KEY=
ZWORKFORCE_SKILL_SIGNING_KEY_REF=
ZWORKFORCE_SKILL_REGISTRY_ALLOWLIST=

# Enterprise identity. SAML deployments can terminate at an identity-aware proxy
# and use the signed proxy identity boundary; native OIDC is supported directly.
ZWORKFORCE_OIDC_ISSUER=
ZWORKFORCE_OIDC_AUDIENCE=
ZWORKFORCE_OIDC_TENANT_CLAIM=tenant
ZWORKFORCE_OIDC_ROLE_CLAIM=role
ZWORKFORCE_OIDC_SCOPES_CLAIM=scope
ZWORKFORCE_OIDC_NAME_CLAIM=preferred_username
ZWORKFORCE_OIDC_DEFAULT_TENANT=default
ZWORKFORCE_OIDC_DEFAULT_ROLE=viewer
ZWORKFORCE_OIDC_GROUP_ROLE_MAP={}
ZWORKFORCE_TRUST_PROXY_IDENTITY=false
ZWORKFORCE_PROXY_IDENTITY_SECRET=
ZWORKFORCE_PROXY_IDENTITY_SECRET_REF=

# OTLP/HTTP JSON tracing (endpoint normally ends in /v1/traces)
ZWORKFORCE_OTLP_TRACES_ENDPOINT=
ZWORKFORCE_OTLP_HEADERS_JSON={}
ZWORKFORCE_SERVICE_NAME=zworkforce
ZWORKFORCE_TRACE_SAMPLE_RATE=1

# Durable integration outbox
ZWORKFORCE_OUTBOX_SIGNING_SECRET=
ZWORKFORCE_OUTBOX_SIGNING_SECRET_REF=

# MCP 2026-07-28 remote client token for CLI mcp-tools/mcp-call
ZWORKFORCE_MCP_TOKEN=

# Optional external stores (used by adapters/CLI integrations)
# ZWORKFORCE_QDRANT_URL=https://qdrant.example.com
# ZWORKFORCE_QDRANT_API_KEY=...
# ZWORKFORCE_S3_BUCKET=zworkforce
# ZWORKFORCE_S3_PREFIX=artifacts/

# Secret backends
VAULT_ADDR=
VAULT_TOKEN=
AWS_REGION=

# Runtime-selectable artifact store
ZWORKFORCE_ARTIFACT_BACKEND=local
# For S3-compatible storage:
# ZWORKFORCE_ARTIFACT_BACKEND=s3
# ZWORKFORCE_S3_BUCKET=zworkforce
# ZWORKFORCE_S3_PREFIX=zworkforce
# ZWORKFORCE_S3_ENDPOINT_URL=https://s3.example.com

# Runtime-selectable semantic memory backend
ZWORKFORCE_VECTOR_BACKEND=local
ZWORKFORCE_LOCAL_VECTOR_DIMENSIONS=128
# Qdrant + OpenAI-compatible embeddings:
# ZWORKFORCE_VECTOR_BACKEND=qdrant
# ZWORKFORCE_QDRANT_URL=https://qdrant.example.com
# ZWORKFORCE_QDRANT_COLLECTION=zworkforce-memory
# ZWORKFORCE_QDRANT_API_KEY=
# ZWORKFORCE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ZWORKFORCE_EMBEDDING_API_KEY=
# ZWORKFORCE_EMBEDDING_MODEL=text-embedding-3-small
# ZWORKFORCE_EMBEDDING_DIMENSIONS=0
# ZWORKFORCE_EMBEDDING_TIMEOUT_SECONDS=30
ZWORKFORCE_OUTBOX_ALLOWLIST=
ZWORKFORCE_EMBEDDING_API_KEY_REF=
ZWORKFORCE_QDRANT_API_KEY_REF=