# Copy this file to .env.release and fill operator-owned values locally.
# Never commit the populated .env.release or any credential value.

# Stage H: the checkout must already contain the exact final candidate.
WINDOWS_HOST=windows-release-host
WINDOWS_REPO_DIR=C:/src/zworkforce
WINDOWS_MSIX_PUBLISHER=CN=Example Organization
# Set this only after downloading the final Azure Artifact Signing output.
WINDOWS_MSIX_EXPECTED_SHA256=
# Optional when the signed package is staged outside WINDOWS_REPO_DIR.
# WINDOWS_MSIX_PATH=D:/release-assets/ZWorkforceClient.msix
ZWORKFORCE_HTTPS_ENDPOINT=https://zworkforce.example.com

# The E/F/G variables remain deployment-specific; provide them from the
# operator's secret/configuration manager rather than storing credentials here.
