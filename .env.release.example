# Copy this file to .env.release and fill operator-owned values locally.
# Never commit the populated .env.release or any credential value.
# PROD = 192.168.1.100
# CORE = 192.168.1.85
# WSL2 = both 192.168.1.85,192.168.1.100
SUDOPASS_CVSZ_PROD=vault://secret/data/zworkforce/build#sudo_pass_prod
SUDOPASS_CVSZ_CORE=vault://secret/data/zworkforce/build#sudo_pass_core
ROOTPASS_WSL2=vault://secret/data/zworkforce/build#root_pass_wsl2
GPG_PASSPHRASE=vault://secret/data/zworkforce/build#gpg_passphrase
# Stage H: the checkout must already contain the exact final candidate.
WINDOWS_HOST=windows-release-host
WINDOWS_REPO_DIR=C:/src/zworkforce
# Self-signed code-signing publisher (generated by scripts/generate-code-signing-cert.sh).
# Azure Artifact Signing is no longer required for local/dev candidates.
WINDOWS_MSIX_PUBLISHER=CN=Example Organization
# Certificate produced by scripts/generate-code-signing-cert.sh (public cert only).
WINDOWS_CODE_SIGNING_CERT=build/windows-certs/code-signing.cer
# PFX path stays operator/CI-side; the password is injected from a secret, never committed.
WINDOWS_CODE_SIGNING_PFX=
WINDOWS_CODE_SIGNING_PFX_PASSWORD_FILE=
# Set this only after signing the built package.
WINDOWS_MSIX_EXPECTED_SHA256=
# The signed candidate workflow's .candidate.txt sidecar must be adjacent to
# the package and contain the frozen SHA, package name, version, and hash.
# Optional when the signed package is staged outside WINDOWS_REPO_DIR.
# WINDOWS_MSIX_PATH=D:/release-assets/ZWorkforceClient.msix
ZWORKFORCE_HTTPS_ENDPOINT=https://zworkforce.example.com

# Stage E air-gapped/preloaded image mode. The provenance file is copied to
# HA_DEPLOY_DIR on both hosts with the docker save archive. Its pinned hash is
# required because docker load normally leaves RepoDigests empty.
# HA_IMAGE_PULL_POLICY=never
# HA_IMAGE_PROVENANCE_FILE=candidate-image-provenance.env
# HA_EXPECTED_IMAGE_PROVENANCE_SHA256=

# Stage G requires an operator-owned receipt service, not httpbin or a query
# echo endpoint. The URL must expose GET /receipt?evidence_id=... and return
# JSON with evidence_id, received_at, alert_count, and payload_sha256.
# ALERT_RECEIVER_TEST_URL=https://alerts.example.com/receipt
# ALERT_RECEIVER_TOKEN_FILE=/secure/path/alert-receiver-token
# RECEIPT_MAX_CLOCK_SKEW_SECONDS=60

# The E/F/G variables remain deployment-specific; provide them from the
# operator's secret/configuration manager rather than storing credentials here.

# zWorkforce production target for Stage E. The verifier checks this project,
# session pooler host/port, and TLS mode without printing the DSN password.
HA_DB_DSN_SECRET_REF=vault://secret/data/zworkforce/postgres-production#password
HA_EXPECTED_DB_PROJECT_REF=
HA_EXPECTED_DB_HOST=
HA_EXPECTED_DB_PORT=5432

# Stage F: exact Supabase project binding. Stage F fails closed if the S3
# endpoint does not resolve to <project-ref>.storage.supabase.co/storage/v1/s3.
SUPABASE_EXPECTED_PROJECT_REF=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET=zworkforce
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY=vault://secret/data/zworkforce/supabase-s3#access_key
SUPABASE_S3_SECRET_KEY=vault://secret/data/zworkforce/supabase-s3#secret_key
SUPABASE_S3_DATABASE=vault://secret/data/zworkforce/supabase-database#password
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=vault://secret/data/zworkforce/supabase#publishable_key
SUPABASE_SECRET_KEY=vault://secret/data/zworkforce/supabase#secret_key
SUPABASE_JWKS_URL=
SUPABASE_JWKS=
SUPABASE_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=vault://secret/data/zworkforce/supabase#next_public_publishable_key
SUPABASE_ACCESS_KEY=vault://secret/data/zworkforce/supabase#access_key
SUPABASE_ACCESS_SECRET_KEY=vault://secret/data/zworkforce/supabase#access_secret_key
SUPABASE_ACTIVE_SHARED_KEYS=vault://secret/data/zworkforce/supabase#active_shared_keys
SUPABASE_STANDBY_KEYS=vault://secret/data/zworkforce/supabase#standby_keys
SUPABASE_AlGORITHM=
