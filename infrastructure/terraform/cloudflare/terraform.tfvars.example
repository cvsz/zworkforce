cloudflare_api_token = "set-via-TF_VAR_cloudflare_api_token"
cloudflare_account_id = "00000000000000000000000000000000"
cloudflare_zone_id    = "00000000000000000000000000000000"
cloudflare_tunnel_id  = "00000000-0000-0000-0000-000000000000"
manage_tunnel_config   = true
manage_free_access     = true
free_access_session_duration = "8h"
free_access_require_mfa = true
free_access_allowed_idps = ["a8cd7aa7-0d5b-4bab-bf7a-e78fc7d86253"]
free_access_service_token_ids = ["8fde4de5-3c1c-4389-a04d-1d3c0416e8dc"]
zone_name             = "zeaz.dev"

app_routes = {
  phase6 = {
    hostname             = "phase6.zeaz.dev"
    service              = "http://phase6-api:8080"
    access_enabled       = true
    allowed_emails       = ["operator@zeaz.dev"]
    allowed_email_domains = ["zeaz.dev"]
  }

  zchat = {
    hostname       = "zchat.zeaz.dev"
    service        = "http://127.0.0.1:3021"
    access_enabled = false
  }

  zchat_staging = {
    hostname       = "zchat-staging.zeaz.dev"
    service        = "http://127.0.0.1:3021"
    access_enabled = false
  }

  zchat_web = {
    hostname       = "zchat-web.zeaz.dev"
    service        = "http://127.0.0.1:3021"
    access_enabled = false
  }

  zwallet = {
    hostname       = "wallet.zeaz.dev"
    service        = "http://zwallet:3040"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  ai_gateway = {
    hostname       = "ai.zeaz.dev"
    service        = "http://z-platform-ai-gateway-1:8400"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  billing_ledger = {
    hostname       = "billing.zeaz.dev"
    service        = "http://z-platform-billing-ledger-1:8700"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  agent_orchestrator = {
    hostname       = "orchestrator.zeaz.dev"
    service        = "http://z-platform-agent-orchestrator-1:8500"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  agent_provider = {
    hostname       = "provider.zeaz.dev"
    service        = "http://z-platform-agent-provider-1:8800"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  workspace_runtime = {
    hostname       = "workspace.zeaz.dev"
    service        = "http://z-platform-workspace-runtime-1:8600"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  grafana = {
    hostname       = "grafana.zeaz.dev"
    service        = "http://127.0.0.1:80"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  prometheus = {
    hostname       = "prometheus.zeaz.dev"
    service        = "http://127.0.0.1:80"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  jaeger = {
    hostname       = "jaeger.zeaz.dev"
    service        = "http://z-platform-phase6-jaeger-1:16686"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

  zaicoder_web = {
    hostname       = "zai.zeaz.dev"
    service        = "http://zaicoder-web:3005"
    access_enabled = true
    allowed_email_domains = ["zeaz.dev"]
  }

}

# zksato — explicit resources are owned by zksato.tf; do not duplicate these
# hostnames in app_routes.
zksato_hostname              = "zksato.zeaz.dev"
zksato_origin                = "http://127.0.0.1:3016"
zksato_api_hostname           = "zksato-api.zeaz.dev"
zksato_api_origin             = "http://127.0.0.1:9569"
zksato_dash_hostname          = "zksato-dash.zeaz.dev"
zksato_dash_origin            = "http://127.0.0.1:5174"
zksato_access_allowed_emails  = []

# Optional second-zone alias. Keep disabled until zaea.dev ownership, zone ID,
# tunnel route, CORS/trusted-host allow-lists, and public DNS are verified.
zksato_alias_enabled          = false
# zksato_alias_zone_id        = "<verified-zaea-dev-zone-id>"

# ─────────────────────────────────────────────────────────────────────
# ZASI — Omniversal Superintelligence J.A.R.V.I.S. Cockpit
# ─────────────────────────────────────────────────────────────────────
enable_zasi   = true
zasi_hostname = "zasi.zeaz.dev"
zasi_origin   = "http://127.0.0.1:8080"

# ─────────────────────────────────────────────────────────────────────
# MoneyPrinterTurbo WebUI
# ─────────────────────────────────────────────────────────────────────
enable_mpt   = true
mpt_hostname = "mpt.zeaz.dev"
mpt_origin   = "http://127.0.0.1:8501"

# ─────────────────────────────────────────────────────────────────────
# zMovie — AI Movie Production Studio
# ─────────────────────────────────────────────────────────────────────
enable_zmovie   = true
zmovie_hostname = "zmovie.zeaz.dev"
zmovie_origin   = "http://127.0.0.1:8080"

# ─────────────────────────────────────────────────────────────────────
# zCoin — CoinFlip Evidence Auditor
# ─────────────────────────────────────────────────────────────────────
coin_hostname              = "zcoin.zeaz.dev"
coin_origin                = "http://127.0.0.1:18082"
coin_access_allowed_emails = []
