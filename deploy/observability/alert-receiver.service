[Unit]
Description=zWorkforce private Alertmanager receipt endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cvsz
Group=cvsz
WorkingDirectory=/opt/zworkforce-observability
Environment=ALERT_RECEIVER_BIND=192.168.74.134
Environment=ALERT_RECEIVER_PORT=18080
Environment=ALERT_RECEIVER_TOKEN_FILE=/opt/zworkforce-observability/alert-receiver-token
Environment=ALERT_RECEIVER_DATA_DIR=/opt/zworkforce-observability/alert-receipts
ExecStart=/usr/bin/python3 /opt/zworkforce-observability/alert_receiver.py
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/zworkforce-observability/alert-receipts
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
