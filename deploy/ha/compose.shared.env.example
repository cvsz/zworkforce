# Shared environment template for HA VM-A and VM-B runtime stacks.
# Copy to /opt/zworkforce/.env on each host and fill secrets.
# Do not commit real secrets.

ZWORKFORCE_IMAGE=ghcr.io/cvsz/zworkforce:v3.0.4
ZWORKFORCE_PORT=9456

# Shared Supabase durable data plane for the zWorkforce release.
# Use the session pooler for long-running VM services and backup/restore
# operations. Resolve the password through the secret manager; do not commit it.
ZWORKFORCE_DATABASE_URL=postgresql://postgres.qhprcfdgajhmdzvnsffb:CHANGE_ME_URL_ENCODED_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Production keys use secret:role[:tenant[:name[:scopes]]].
# Replace this example with a real >=24-character secret before deployment.
ZWORKFORCE_API_KEYS=CHANGE_ME_WITH_24_PLUS_CHARS:admin

# Provider
ZWORKFORCE_PROVIDER=openai-compatible
ZWORKFORCE_PROVIDER_BASE_URL=https://api.openai.com/v1
ZWORKFORCE_PROVIDER_API_KEY=

# S3-compatible artifact backend (Supabase Storage).
ZWORKFORCE_ARTIFACT_BACKEND=s3
ZWORKFORCE_S3_BUCKET=zworkforce
ZWORKFORCE_S3_PREFIX=artifacts
ZWORKFORCE_S3_ENDPOINT_URL=https://qhprcfdgajhmdzvnsffb.storage.supabase.co/storage/v1/s3
ZWORKFORCE_S3_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Metrics bearer token (must match observability scrape config).
ZWORKFORCE_METRICS_BEARER=

# Instance identity for lease/outbox ownership.
# VM-A should set ZWORKFORCE_INSTANCE_ID=vm-a
# VM-B should set ZWORKFORCE_INSTANCE_ID=vm-b
