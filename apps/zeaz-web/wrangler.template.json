{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeaz-web",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "www.zeaz.dev/*", "zone_name": "zeaz.dev" },
    { "pattern": "zeaz.dev/*", "zone_name": "zeaz.dev" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "NOTIFICATION_FROM": "ZEAZ One <noreply@zeaz.dev>"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "zeaz-web", "database_id": "__D1_DATABASE_ID__", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
