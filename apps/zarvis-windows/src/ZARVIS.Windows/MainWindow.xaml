<Window x:Class="ZARVIS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z.A.R.V.I.S. — Windows Client"
        Height="720"
        Width="1040"
        MinHeight="650"
        MinWidth="900"
        Background="{StaticResource WindowBackground}"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Z.A.R.V.I.S." FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Secure Windows 11 client for the owner-only local runtime"
                   Foreground="{StaticResource Muted}" FontSize="14"/>
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource PanelBackground}"
              CornerRadius="12" Padding="16,10">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#E05A67" Margin="0,0,10,0"/>
          <TextBlock x:Name="StatusText" Text="Disconnected" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="430"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
              CornerRadius="14" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Secure connection" FontSize="20" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>
            <Label Content="Server host or IP"/>
            <TextBox x:Name="ServerHostBox"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="110"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Label Content="SSH user"/>
                <TextBox x:Name="SshUserBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Label Content="SSH port"/>
                <TextBox x:Name="SshPortBox"/>
              </StackPanel>
            </Grid>
            <Label Content="Private key path (optional when SSH agent is configured)"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PrivateKeyBox" Margin="0,4,8,10"/>
              <Button Grid.Column="1" Content="Browse…" Click="BrowseKey_Click"
                      Margin="0,4,0,10"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Label Content="Action local port"/>
                <TextBox x:Name="ActionPortBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Label Content="Proactive local port"/>
                <TextBox x:Name="ProactivePortBox"/>
              </StackPanel>
            </Grid>
            <CheckBox x:Name="AutoConnectCheck" Content="Connect automatically at startup"
                      Foreground="White" Margin="0,4,0,14"/>
            <WrapPanel>
              <Button x:Name="ConnectButton" Content="Start secure connection"
                      Background="#1B776D" Click="Connect_Click"/>
              <Button x:Name="DisconnectButton" Content="Stop" IsEnabled="False"
                      Click="Disconnect_Click"/>
              <Button Content="Save settings" Click="Save_Click"/>
            </WrapPanel>
            <TextBlock Text="The client stores only connection settings. Owner Token is never written to disk."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Margin="4,14,4,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBackground}"
              CornerRadius="14" Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Owner console" FontSize="20" FontWeight="SemiBold"
                     Margin="0,0,0,16"/>
          <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button x:Name="OpenActionButton" Content="Open Action Console"
                    IsEnabled="False" Click="OpenAction_Click"/>
            <Button x:Name="OpenProactiveButton" Content="Open Proactive Console"
                    IsEnabled="False" Click="OpenProactive_Click"/>
            <Button x:Name="CopyTokenButton" Content="Copy Owner Token (60 sec)"
                    IsEnabled="False" Click="CopyToken_Click"/>
            <Button Content="Open GitHub Releases" Click="OpenReleasePage_Click"/>
          </WrapPanel>
          <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True"
                   TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="Transport: Windows OpenSSH • Server exposure: loopback-only • Owner: GitHub ID 4076926"
               Foreground="{StaticResource Muted}" Margin="2,16,0,0"/>
  </Grid>
</Window>
