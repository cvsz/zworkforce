<Application x:Class="ZARVIS.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#08111F"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#101D2F"/>
    <SolidColorBrush x:Key="FieldBackground" Color="#17263A"/>
    <SolidColorBrush x:Key="Primary" Color="#43D9C3"/>
    <SolidColorBrush x:Key="Muted" Color="#8EA2BC"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#29415E"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,4,0,10"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1E3550"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#34577D"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="0,0,0,2"/>
    </Style>
  </Application.Resources>
</Application>
