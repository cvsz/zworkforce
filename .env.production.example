# zWorkforce production template.
# Copy outside source control, replace all placeholders, then restrict permissions.

ZWORKFORCE_ENV=production
ZWORKFORCE_HOST=0.0.0.0
ZWORKFORCE_PORT=9569
ZWORKFORCE_EMBEDDED_WORKERS=0

# Immutable container image deployed by Compose.
ZWORKFORCE_IMAGE=ghcr.io/cvsz/zworkforce:v3.0.4

# Database
ZWORKFORCE_POSTGRES_PASSWORD=REPLACE_ME
ZWORKFORCE_DATABASE_URL=postgresql://zworkforce:REPLACE_ME@postgres:5432/zworkforce

# Bootstrap/API access: replace then rotate after production bootstrap.
ZWORKFORCE_API_KEYS=REPLACE_ME:superadmin:default:bootstrap:*

# Provider/model configuration. Prefer *_REF where supported.
ZWORKFORCE_PROVIDER=openai-compatible
ZWORKFORCE_PROVIDER_BASE_URL=https://api.openai.com/v1
ZWORKFORCE_PROVIDER_API_KEY_REF=env://OPENAI_API_KEY
OPENAI_API_KEY=REPLACE_ME
ZWORKFORCE_MODEL_SOL=REPLACE_WITH_SUPPORTED_MODEL
ZWORKFORCE_MODEL_TERRA=REPLACE_WITH_SUPPORTED_MODEL
ZWORKFORCE_MODEL_LUNA=REPLACE_WITH_SUPPORTED_MODEL

# Identity
ZWORKFORCE_OIDC_ISSUER=
ZWORKFORCE_OIDC_AUDIENCE=

# Network/tool policy
ZWORKFORCE_HTTP_ALLOWLIST=
ZWORKFORCE_SHELL_ENABLED=false

# Secret/signature boundaries
ZWORKFORCE_SKILL_SIGNING_KEY=
ZWORKFORCE_OUTBOX_SIGNING_SECRET=

# Observability
ZWORKFORCE_OTLP_TRACES_ENDPOINT=

# Artifacts
ZWORKFORCE_ARTIFACT_BACKEND=local
ZWORKFORCE_S3_BUCKET=
ZWORKFORCE_S3_PREFIX=zworkforce
ZWORKFORCE_S3_ENDPOINT_URL=

# Semantic memory
ZWORKFORCE_VECTOR_BACKEND=local
ZWORKFORCE_LOCAL_VECTOR_DIMENSIONS=128
ZWORKFORCE_QDRANT_URL=
ZWORKFORCE_QDRANT_COLLECTION=zworkforce-memory
ZWORKFORCE_QDRANT_API_KEY=
ZWORKFORCE_EMBEDDING_BASE_URL=
ZWORKFORCE_EMBEDDING_API_KEY=
ZWORKFORCE_EMBEDDING_MODEL=
ZWORKFORCE_EMBEDDING_DIMENSIONS=0
